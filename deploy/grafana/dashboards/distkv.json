{
  "uid": "distkv",
  "title": "DistKV",
  "tags": [
    "distkv",
    "raft"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Throughput",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(distkv_requests_total[1m]))",
          "legendFormat": "total ops/s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (5xx-free, 5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(distkv_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(distkv_requests_total[5m]))",
          "legendFormat": "availability"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(distkv_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Shards with a leader",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (shard) (distkv_raft_has_leader) == 1)",
          "legendFormat": "healthy shards"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by op and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op, status) (rate(distkv_requests_total[1m]))",
          "legendFormat": "{{op}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "Server-side latency, excluding client network time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, op) (rate(distkv_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{op}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, op) (rate(distkv_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{op}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.999, sum by (le, op) (rate(distkv_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99.9 {{op}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Leaders per node",
      "description": "The balancer moves each shard back to its preferred replica, so this should be even.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (distkv_raft_is_leader)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Raft term by shard",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (shard) (distkv_raft_term)",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Elections (rate)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(distkv_raft_elections_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Follower lag (entries)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (shard, follower) (distkv_raft_follower_lag_entries)",
          "legendFormat": "shard {{shard}} \u2192 {{follower}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Commit rate by shard",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (shard) (rate(distkv_raft_commit_index[1m])) / count by (shard) (distkv_raft_commit_index)",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Keys by shard",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (shard) (distkv_kv_keys)",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory used by shard",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (shard) (distkv_kv_bytes)",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Evictions / expirations / dedup hits",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(distkv_kv_evictions_total[5m]))",
          "legendFormat": "LRU evictions"
        },
        {
          "refId": "B",
          "expr": "sum(rate(distkv_kv_expirations_total[5m]))",
          "legendFormat": "TTL expirations"
        },
        {
          "refId": "C",
          "expr": "sum(rate(distkv_kv_dedup_hits_total[5m]))",
          "legendFormat": "retries deduplicated"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Read path",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(distkv_raft_lease_reads_total[1m]))",
          "legendFormat": "lease reads/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(distkv_raft_read_index_rounds_total[1m]))",
          "legendFormat": "ReadIndex rounds/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(distkv_forwarded_requests_total[1m]))",
          "legendFormat": "forwarded req/s"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Snapshots",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(distkv_raft_snapshots_taken_total[10m]))",
          "legendFormat": "taken (10m)"
        },
        {
          "refId": "B",
          "expr": "sum(increase(distkv_raft_snapshots_installed_total[10m]))",
          "legendFormat": "installed (10m)"
        }
      ]
    }
  ]
}